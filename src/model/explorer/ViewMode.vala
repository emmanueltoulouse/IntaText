namespace IntaText {
/**
  * Définit les différents modes d'affichage pour l'explorateur de fichiers
  */
public enum ViewMode {
    LIST,           // Vue en liste détaillée (nom, taille, date, etc.)
    ICONS,          // Vue en grandes icônes
    COMPACT         // Vue en liste compacte
}
}
