{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"detail": "Compile le projet avec Meson",
			"icon": {
				"id": "tools",
				"color": "terminal.ansiGreen"
			},
			"type": "shell",
			"command": "meson compile -C build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"problemMatcher": [
				{
					"owner": "vala",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": [
						{
							"regexp": "^(.*):(\\d+)\\.(\\d+)-(\\d+)\\.(\\d+): (error|warning|note): (.*)$",
							"file": 1,
							"line": 2,
							"column": 3,
							"endLine": 4,
							"endColumn": 5,
							"severity": 6,
							"message": 7
						},
						{
							"regexp": "^(.*):(\\d+):(\\d+): (error|warning|note): (.*)$",
							"file": 1,
							"line": 2,
							"column": 3,
							"severity": 4,
							"message": 5
						},
						{
							"regexp": "^(.*?):(?:(\\d+):)?(\\d+):(\\d+): (.*?)(?:\\[(.*?)\\])?: (.*)$",
							"file": 1,
							"line": 3,
							"column": 4,
							"message": 7,
							"code": 6,
							"severity": 5
						}
					]
				},
				"$valac",
				"$gcc"
			],
			"dependsOn": [
				"check-dependencies"
			]
		},
		{
			"label": "check-dependencies",
			"detail": "Vérifie si les dépendances sont installées",
			"type": "shell",
			"command": "if ! command -v valac > /dev/null || ! command -v meson > /dev/null; then echo \"ERREUR: valac ou meson n'est pas installé\"; exit 1; fi && if [ ! -d build ]; then echo \"Configuration du projet...\"; meson setup build; fi",
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem"
			}
		},
		{
			"label": "clean",
			"detail": "Nettoie le dossier de build",
			"icon": {
				"color": "terminal.ansiRed"
			},
			"type": "shell",
			"command": "rm -rf build",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "run",
			"detail": "Lance l'application sans recompilation",
			"icon": {
				"id": "run-all",
				"color": "terminal.ansiBlue"
			},
			"type": "shell",
			"command": "if [ -f ./build/IntaText ]; then GSETTINGS_SCHEMA_DIR=/usr/local/share/glib-2.0/schemas ./build/IntaText; else echo \"L'application n'est pas compilée. Exécutez d'abord 'build'.\"; exit 1; fi",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Compil et Execute",
			"detail": "Compile et lance l'application",
			"icon": {
				"id": "play-circle",
				"color": "terminal.ansiGreen"
			},
			"type": "shell",
			"command": "ninja -C build && GSETTINGS_SCHEMA_DIR=/usr/local/share/glib-2.0/schemas ./build/IntaText",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"problemMatcher": {
				"owner": "vala",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": [
					{
						"regexp": "^(.*):(\\d+)\\.(\\d+)-(\\d+)\\.(\\d+): (error|warning|note): (.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"endLine": 4,
						"endColumn": 5,
						"severity": 6,
						"message": 7
					},
					{
						"regexp": "^(.*):(\\d+):(\\d+): (error|warning|note): (.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": 4,
						"message": 5
					},
					{
						"regexp": "^(.*?):(?:(\\d+):)?(\\d+):(\\d+): (.*?)(?:\\[(.*?)\\])?: (.*)$",
						"file": 1,
						"line": 3,
						"column": 4,
						"message": 7,
						"code": 6,
						"severity": 5
					}
				]
			}
		},
		{
			"label": "setup-gschema",
			"detail": "Configure et compile le schéma GSettings",
			"icon": {
				"id": "settings",
				"color": "terminal.ansiMagenta"
			},
			"type": "shell",
			"command": "mkdir -p ~/.local/share/glib-2.0/schemas && cp data/IntaText.gschema.xml ~/.local/share/glib-2.0/schemas/ && glib-compile-schemas ~/.local/share/glib-2.0/schemas/",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "lint",
			"detail": "Vérifie le style du code",
			"icon": {
				"id": "checklist",
				"color": "terminal.ansiYellow"
			},
			"type": "shell",
			"command": "find src -name '*.vala' | xargs -I{} bash -c 'echo \"Vérification de {}\"; if grep -q \"\\t\" {}; then echo \"AVERTISSEMENT: Tabulations dans {}\"; fi; if grep -qE \"[[:space:]]+$\" {}; then echo \"AVERTISSEMENT: Espaces en fin de ligne dans {}\"; fi'",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": {
				"owner": "vala-lint",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^AVERTISSEMENT: (.*) dans (.*)$",
					"message": 1,
					"file": 2
				}
			}
		},
		{
			"label": "format",
			"detail": "Formate le code avec Uncrustify",
			"icon": {
				"id": "symbol-ruler",
				"color": "terminal.ansiCyan"
			},
			"type": "shell",
			"command": "find src -name '*.vala' | xargs -n1 uncrustify -c .uncrustify.cfg --replace --no-backup",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "lint-uncrustify",
			"detail": "Vérifie le style du code avec Uncrustify (sans modifier les fichiers)",
			"icon": {
				"id": "checklist",
				"color": "terminal.ansiYellow"
			},
			"type": "shell",
			"command": "find src -name '*.vala' | xargs -n1 uncrustify -c .uncrustify.cfg --check",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "kill-app",
			"detail": "Tue toute instance en cours d'exécution de l'application",
			"type": "shell",
			"command": "pkill -f IntaText || true",
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem"
			},
			"problemMatcher": []
		},
		{
			"label": "run-tests",
			"type": "shell",
			"command": "./tests/run_tests.sh",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}