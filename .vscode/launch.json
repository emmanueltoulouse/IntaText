{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Exécuter IntaText",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/IntaText",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GSETTINGS_SCHEMA_DIR",
                    "value": "/usr/local/share/glib-2.0/schemas"
                },
                {
                    "name": "G_MESSAGES_DEBUG",
                    "value": "all"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Activer l'affichage amélioré pour gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Exécuter sans recompiler",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/IntaText",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GSETTINGS_SCHEMA_DIR",
                    "value": "/usr/local/share/glib-2.0/schemas"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Activer l'affichage amélioré pour gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
